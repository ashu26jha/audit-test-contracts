# Build stage
FROM node:22.12.0-slim

# Define build arguments - only for variables needed at build time (prefixed with NEXT_PUBLIC_)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GITHUB_APP_URL

# Set public environment variables needed at build time (prefixed with NEXT_PUBLIC_)
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    NEXT_PUBLIC_GITHUB_APP_URL=${NEXT_PUBLIC_GITHUB_APP_URL}

# Create a non-root user
RUN groupadd -r appuser && useradd -r -g appuser -m appuser

# Set the working directory inside the container
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies and required packages
RUN npm install --ignore-scripts && \
    apt-get update && \
    apt-get install -y nginx apache2-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /root/.npm/* && \
    mkdir -p .next && \
    chown -R appuser:appuser /app

# Copy the rest of your application code with proper ownership
COPY --chown=appuser:appuser . .

# Switch to non-root user for build
USER appuser

# Build the application
RUN npm run build

# Switch back to root for nginx setup
USER root

# Copy the Nginx configuration file
COPY nginx.conf /etc/nginx/nginx.conf
COPY .htpasswd /etc/nginx/.htpasswd

# Expose the port Nginx will use
EXPOSE 80

# Start the Node.js app and Nginx
CMD ["sh", "-c", "npm start & nginx -g 'daemon off;'"]
