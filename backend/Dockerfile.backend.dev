# Build stage
FROM python:3.12.0-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Install build dependencies, Foundry, Stripe CLI and Rust
RUN apt-get update && apt-get install -y --no-install-recommends\
    build-essential \
    curl \
    git \
    gnupg \
    libssl-dev \
    pkg-config \
    wget \
    && curl --proto "=https" -L https://foundry.paradigm.xyz | bash \
    && /root/.foundry/bin/foundryup \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . "$HOME/.cargo/env" \
    && curl -s https://packages.stripe.dev/api/security/keypair/stripe-cli-gpg/public | gpg --dearmor | tee /usr/share/keyrings/stripe.gpg > /dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/stripe.gpg] \
    https://packages.stripe.dev/stripe-cli-debian-local \
    stable main" | tee -a /etc/apt/sources.list.d/stripe.list \
    && apt-get update && apt-get --no-install-recommends install -y stripe \
    && git clone --branch v0.3.3 https://github.com/Cyfrin/aderyn.git \
    && cd aderyn \
    && cargo build --release \
    && mkdir -p /root/.cyfrin/bin \
    && cp target/release/aderyn /root/.cyfrin/bin/ \
    && cd .. \
    && rm -rf aderyn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Final stage
FROM python:3.12.0-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.foundry/bin:/root/.cyfrin/bin:${PATH}"

# Copy installed tools from builder stage
COPY --from=builder /root/.foundry /root/.foundry
COPY --from=builder /usr/local/bin/stripe /usr/local/bin/stripe

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    && curl --proto "=https" --tlsv1.2 -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=20.* \
    && npm install -g --ignore-scripts npm@latest \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/* /root/.cache/*

# Install Python dependencies, Playwright (Chromium only), and Aderyn
WORKDIR /app/backend
COPY requirements.dev.txt .
COPY --from=builder /root/.cyfrin/bin/aderyn /root/.cyfrin/bin/aderyn

RUN pip install --no-cache-dir -r requirements.dev.txt \
    && pip install --no-cache-dir slither-analyzer==0.10.0 solc-select==1.0.4 toml==0.10.2 \
    && playwright install chromium --with-deps \
    && chmod +x /root/.cyfrin/bin/aderyn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/* 

# Copy application code
COPY . .

EXPOSE 8000

# Start Stripe listener and the application
CMD ["sh", "-c", "(stripe listen --forward-to http://localhost:8000/api/v1/payments/stripe-webhook &) && python3 main.py"]
