# Build stage
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Install build dependencies, Foundry and Stripe CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    git \
    gnupg \
    wget \
    xz-utils \
    # Install Foundry
    && curl --proto "=https" -L https://foundry.paradigm.xyz | bash \
    && /root/.foundry/bin/foundryup \
    # Install Stripe CLI
    && curl -s https://packages.stripe.dev/api/security/keypair/stripe-cli-gpg/public | gpg --dearmor | tee /usr/share/keyrings/stripe.gpg > /dev/null \
    && echo "deb [signed-by=/usr/share/keyrings/stripe.gpg] \
    https://packages.stripe.dev/stripe-cli-debian-local \
    stable main" | tee -a /etc/apt/sources.list.d/stripe.list \
    && apt-get update && apt-get --no-install-recommends install -y stripe \
    # Install Aderyn v0.4.0 with checksum verification
    && ADERYN_VERSION="0.4.0" \
    && ADERYN_ARCH="x86_64-unknown-linux-gnu" \
    && curl --proto "=https" --tlsv1.2 -fsSL -LO "https://github.com/cyfrin/aderyn/releases/download/aderyn-v${ADERYN_VERSION}/aderyn-${ADERYN_ARCH}.tar.xz" \
    && curl --proto "=https" --tlsv1.2 -fsSL -LO "https://github.com/cyfrin/aderyn/releases/download/aderyn-v${ADERYN_VERSION}/aderyn-${ADERYN_ARCH}.tar.xz.sha256" \
    && sha256sum -c "aderyn-${ADERYN_ARCH}.tar.xz.sha256" \
    && mkdir -p aderyn-temp \
    && tar -xf "aderyn-${ADERYN_ARCH}.tar.xz" -C aderyn-temp \
    && find aderyn-temp -type f -executable -name "aderyn*" -exec mv {} /usr/local/bin/aderyn \; \
    && chmod +x /usr/local/bin/aderyn \
    # Clean up
    && rm -rf aderyn-temp "aderyn-${ADERYN_ARCH}.tar.xz" "aderyn-${ADERYN_ARCH}.tar.xz.sha256" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Final stage
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.foundry/bin:/root/.cyfrin/bin:${PATH}"

# Copy installed tools from builder stage
COPY --from=builder /root/.foundry /root/.foundry
COPY --from=builder /usr/bin/stripe /usr/local/bin/stripe
COPY --from=builder /usr/local/bin/aderyn /usr/local/bin/aderyn

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    # Install Node.js
    && curl --proto "=https" --tlsv1.2 -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=20.* \
    && npm install -g --ignore-scripts npm@latest \
    # Clean up
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/* /root/.cache/*

# Create and activate virtual environment
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install Python dependencies in virtual environment
WORKDIR /app/backend
COPY requirements.dev.txt .

RUN pip install --no-cache-dir setuptools wheel \
    && pip install --no-cache-dir -r requirements.dev.txt \
    && playwright install chromium --with-deps --only-shell \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/*

# Copy application code
COPY api ./api
COPY config ./config
COPY core ./core
COPY main.py .
COPY .env .

EXPOSE 8000

# Start Stripe listener and the application
CMD ["sh", "-c", "(stripe listen --forward-to http://localhost:8000/api/v1/payments/stripe-webhook &) && python3 main.py"]