# Use a specific Python version instead of the latest
FROM python:3.12.0-slim

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Install git and other necessary dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Foundry
RUN curl -L https://foundry.paradigm.xyz | bash && \
    /root/.foundry/bin/foundryup
ENV PATH="/root/.foundry/bin:${PATH}"


# Set the working directory in the container
WORKDIR /app/backend

# Copy the requirements.txt file into the container
COPY requirements.txt .

# Install the Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install toml
RUN pip install toml

# Install Slither
RUN pip install --no-cache-dir --upgrade slither-analyzer

# Install solc-select
RUN pip3 install solc-select

# Install playwright
RUN playwright install 
RUN playwright install-deps 

# Copy the rest of your application code into the container
COPY . .

# Set environment variable for Python to run in unbuffered mode
ENV PYTHONUNBUFFERED=1

# Expose the port that your backend will run on
EXPOSE 8000

# Install Redis
RUN apt-get update && apt-get install -y redis-server

# Start Redis server before your application
CMD redis-server --daemonize yes && redis-cli ping && python3 main.py