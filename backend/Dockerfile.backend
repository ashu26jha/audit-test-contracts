# Use a specific Python version instead of the latest
FROM python:3.12.0-slim

# Install git and other necessary dependencies
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory in the container
WORKDIR /app/backend

# Copy the requirements.txt file into the container
COPY requirements.txt .

# Install the Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install playwright
RUN playwright install 
RUN playwright install-deps 

# Copy the rest of your application code into the container
COPY . .

# Expose the port that your backend will run on
EXPOSE 8000

# Install Redis and Doppler
RUN apt-get update && apt-get install -y apt-transport-https ca-certificates curl gnupg
RUN curl -sLf --retry 3 --tlsv1.2 --proto "=https" 'https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key' | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg
RUN echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" | tee /etc/apt/sources.list.d/doppler-cli.list
RUN apt-get update && apt-get install -y redis-server doppler

# Start Redis server before your application
CMD redis-server --daemonize yes && redis-cli ping && doppler run -- python3 main.py