# Build stage
FROM python:3.12.0-slim AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Install build dependencies, Foundry and Rust
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    gnupg \
    libssl-dev \
    pkg-config \
    wget \
    && curl --proto "=https" -L https://foundry.paradigm.xyz | bash \
    && /root/.foundry/bin/foundryup \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && . "$HOME/.cargo/env" \
    && git clone --branch v0.3.3 https://github.com/Cyfrin/aderyn.git \
    && cd aderyn \
    && cargo build --release \
    && mkdir -p /root/.cyfrin/bin \
    && cp target/release/aderyn /root/.cyfrin/bin/ \
    && cd .. \
    && rm -rf aderyn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Final stage
FROM python:3.12.0-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PATH="/root/.foundry/bin:/root/.cyfrin/bin:${PATH}"

# Copy installed tools from builder stage
COPY --from=builder /root/.foundry /root/.foundry

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gnupg \
    && curl --proto "=https" --tlsv1.2 -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs=20.* \
    && npm install -g --ignore-scripts npm@latest \
    # Install Doppler
    && curl -sLf --retry 3 --tlsv1.2 --proto "=https" 'https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key' | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" | tee /etc/apt/sources.list.d/doppler-cli.list \
    && apt-get update && apt-get --no-install-recommends install -y doppler \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/* /root/.cache/*

# Install Python dependencies, Playwright (Chromium only), and Aderyn
WORKDIR /app/backend
COPY requirements.txt .
COPY --from=builder /root/.cyfrin/bin/aderyn /root/.cyfrin/bin/aderyn

RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir slither-analyzer==0.10.0 solc-select==1.0.4 toml==0.10.2 \
    && playwright install chromium --with-deps \
    && chmod +x /root/.cyfrin/bin/aderyn \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /root/.npm/*

# Copy application code
COPY . .

EXPOSE 8000

# Start the application with Doppler
CMD ["sh", "-c", "doppler run -- python3 main.py"]
